+/* Match Gufo's cooperative empty-CQ polling without changing completion
+ * semantics. A busy user poller can otherwise defer the kernel ring workers
+ * that make the very completion it is waiting for. Default remains off. */
+static int tp_roce_parse_cq_yield(const char *text,unsigned *out) {
+    *out=0;
+    if(!text) return 1;
+    char *end=NULL;errno=0;
+    unsigned long n=strtoul(text,&end,10);
+    if(errno || !*text || *end || n>4096 || (n && (n&(n-1)))) { errno=EINVAL;return 0; }
+    *out=(unsigned)n;return 1;
+}
+static void tp_roce_cq_pause(unsigned interval,unsigned *spins) {
+    if(!interval) return;
+    if((++*spins & (interval-1))==0) { sched_yield();return; }
+#if defined(__x86_64__) || defined(__i386__)
+    __builtin_ia32_pause();
+#else
+    __asm__ volatile("" ::: "memory");
+#endif
+}
