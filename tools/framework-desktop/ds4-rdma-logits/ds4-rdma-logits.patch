+    if(!count || bytes>TP_RC_WINDOW*(uint64_t)TP_RC_CHUNK-4095u || (!out)==(!in)) {
+        errno=EINVAL;ds4_tp_mark_failed(tp);return 0;
+    }
+    const size_t wire=((size_t)bytes+4095u)&~(size_t)4095u;
